# Copy this file to .env and fill in your values before deploying.
# Never commit the real .env to git!

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── LibreOffice (required for PDF generation) ─────────────────────────────────
# Local Windows (example):
#   LIBREOFFICE_PATH="C:\Program Files\LibreOffice\program\soffice.exe"
# Ubuntu/Render (example):
#   LIBREOFFICE_PATH=/usr/bin/soffice
LIBREOFFICE_PATH=

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/gse_quotes?retryWrites=true&w=majority

# ── Google Sheets Webhook ─────────────────────────────────────────────────────
SHEETS_WEBHOOK_URL=

# ── CORS ──────────────────────────────────────────────────────────────────────
# For production, set this to your exact frontend origin, e.g.:
#   CORS_ORIGIN=https://yourusername.github.io
# Leave blank or omit for local development (defaults to "*")
CORS_ORIGIN=*
